{
  "file": "data/public/resources.provenance.json",
  "format": "json",
  "description": "Where each public value came from, one object per row of resources.public.json with the same id: the raw guide fields the finder does not show, the geocoder's match, the PDF listing, the service type and audience tagging and their review flags. Written by build_data.py and committed.",
  "booleans": "python",
  "lists": "semicolon",
  "columns": {
    "id": {"type": "text", "required": true, "unique": true, "pattern": "^(\\d+(-\\d+)?|feature-\\d+)$", "description": "the stable id from data/resource_ids.csv"},
    "category": {"type": "text"},
    "subcategory": {"type": "text"},
    "works_with_currently_incarcerated": {"type": "boolean"},
    "ati_program": {"type": "boolean"},
    "know_your_rights_content": {"type": "boolean"},
    "notes": {"type": "text"},
    "geocode_match": {"type": "text", "required": true, "values": "$geocode_matches"},
    "geocode_source": {"type": "text", "values": "$geocode_sources"},
    "geocode_matched_address": {"type": "text"},
    "geocode_review": {"type": "text"},
    "service_type": {"type": "text", "values": "$service_types"},
    "service_type_suggested": {"type": "list", "items": "$service_types"},
    "service_type_source": {"type": "text", "values": "$service_type_sources"},
    "service_type_confidence": {"type": "text", "values": "$service_type_confidences"},
    "organization_service_types": {"type": "list", "items": "$service_types"},
    "service_type_conflict": {"type": "boolean"},
    "needs_review": {"type": "boolean"},
    "review_notes": {"type": "text"},
    "pdf_match_method": {"type": "text", "values": "$pdf_match_methods"},
    "pdf_listing_id": {"type": "integer"},
    "pdf_chapter": {"type": "text", "values": "$guide_chapters"},
    "pdf_section": {"type": "text"},
    "pdf_preceding_subheading": {"type": "text"},
    "pdf_guide_page": {"type": "integer", "min": 1},
    "pdf_is_cross_reference": {"type": "boolean"},
    "pdf_section_service_type": {"type": "text", "values": "$service_types"},
    "pdf_appearances": {"type": "list"},
    "pdf_org_service_types": {"type": "list", "items": "$service_types"},
    "service_type_extended": {"type": "text", "values": "$service_types"},
    "service_type_extended_source": {"type": "text", "values": "$service_type_extended_sources"},
    "service_subtype_extended": {"type": "text"},
    "description_keyword_types": {"type": "list", "items": "$service_types"},
    "description_service_types": {"type": "list", "items": "$service_types_extended"},
    "description_service_types_source": {"type": "text", "description": "a list in resources_extended.csv, but the table column is text"},
    "pdf_contradiction": {"type": "text"},
    "needs_review_extended": {"type": "boolean"},
    "review_notes_extended": {"type": "text"},
    "confirmed_pdf_audiences": {"type": "list", "items": "$audiences"},
    "unconfirmed_pdf_audiences": {"type": "list", "items": "$audiences"},
    "pdf_audience_check": {"type": "text", "values": "$pdf_audience_checks"},
    "audience_restriction": {"type": "text", "values": "$audience_restrictions"},
    "restriction_evidence": {"type": "text"},
    "everyone_basis": {"type": "text", "values": "$everyone_bases"},
    "audience_needs_review": {"type": "boolean"},
    "audience_reviewed": {"type": "boolean"}
  }
}
