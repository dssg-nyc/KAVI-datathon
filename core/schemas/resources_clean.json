{
  "file": "data/cleaned/resources_clean.csv",
  "format": "csv",
  "description": "Output of step 1 (clean_guide.py): one row per guide entry, text trimmed, ZIPs and websites fixed, a first service_type assigned. Rules in docs/datathon/cleaning.md.",
  "booleans": "python",
  "lists": "semicolon",
  "columns": {
    "resource_id": {"type": "integer", "required": true, "unique": true, "description": "1-based position in the raw guide export; the key every later file joins on"},
    "org_name": {"type": "text", "required": true},
    "service_type": {"type": "text", "values": "$service_types", "description": "blank until a service type is assigned (see service_type_source)"},
    "service_type_suggested": {"type": "list", "items": "$service_types"},
    "guide_category": {"type": "text", "values": "$guide_chapters"},
    "guide_subcategory": {"type": "text"},
    "street": {"type": "text"},
    "address_line_2": {"type": "text"},
    "city": {"type": "text"},
    "state": {"type": "text", "pattern": "^[A-Z]{2}$"},
    "zip": {"type": "text", "pattern": "^\\d{5}(-\\d{4})?$"},
    "borough": {"type": "text", "values": "$boroughs"},
    "latitude": {"type": "number", "min": -90, "max": 90, "description": "blank: coordinates come from step 3"},
    "longitude": {"type": "number", "min": -180, "max": 180},
    "phone": {"type": "text"},
    "website": {"type": "text", "pattern": "^https?://"},
    "description": {"type": "text"},
    "spanish_speaking": {"type": "yes_no"},
    "pre_release": {"type": "yes_no"},
    "ati_program": {"type": "yes_no"},
    "know_your_rights": {"type": "yes_no"},
    "row_type": {"type": "text", "required": true, "values": "$row_types"},
    "status": {"type": "text", "required": true, "values": ["active"]},
    "source": {"type": "text", "required": true},
    "in_nomatch_file": {"type": "boolean", "required": true},
    "service_type_source": {"type": "text", "required": true, "values": "$service_type_sources"},
    "service_type_confidence": {"type": "text", "required": true, "values": "$service_type_confidences"},
    "organization_service_types": {"type": "list", "items": "$service_types"},
    "service_type_conflict": {"type": "boolean", "required": true},
    "needs_review": {"type": "boolean", "required": true},
    "review_notes": {"type": "text"}
  }
}
