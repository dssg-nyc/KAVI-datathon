{
  "file": "data/nypl_connections_resources.geojson",
  "format": "geojson",
  "description": "Output of step 3 (geocode.py): one Point feature per raw guide row, in file order, with the raw guide columns as properties. Geometry is null when no geocoder placed the row. Rules in docs/datathon/geocoding.md.",
  "booleans": "python",
  "lists": "semicolon",
  "columns": {
    "Organization Name": {"type": "text"},
    "Street Number": {"type": "text"},
    "Address Line 2": {"type": "text"},
    "Street": {"type": "text"},
    "City": {"type": "text"},
    "State": {"type": "text"},
    "Zip Code": {"type": "text"},
    "Phone Number": {"type": "text"},
    "Website": {"type": "text"},
    "Description": {"type": "text"},
    "Category": {"type": "text"},
    "Subcategory": {"type": "text"},
    "Spanish-speaking (Y/N)": {"type": "yes_no"},
    "Works w/ Currently Incarcerated/Pre-release (Y/N)": {"type": "yes_no"},
    "ATI Program (Y/N)": {"type": "yes_no"},
    "Know Your Rights Content (Y/N)": {"type": "yes_no"},
    "Notes": {"type": "text"},
    "addr:housenumber": {"type": "text", "description": "the addr:* properties are set only where a geocoder matched"},
    "addr:street": {"type": "text"},
    "addr:city": {"type": "text"},
    "addr:state": {"type": "text"},
    "addr:postcode": {"type": "text"},
    "addr:country": {"type": "text"},
    "geocode_match": {"type": "text", "required": true, "values": "$geocode_matches"},
    "geocode_source": {"type": "text", "values": "$geocode_sources"},
    "geocode_matched_address": {"type": "text"},
    "geocode_review": {"type": "text"}
  }
}
