{
  "name": "kavi-resource-map",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "dev": "node app/dev-server.mjs",
    "import": "node pipeline/5_load/load_supabase.mjs",
    "pipeline": "python3 pipeline/run.py",
    "ids": "node pipeline/6_build/resource_ids.ts",
    "build:data": "node pipeline/6_build/build_data.ts",
    "layers": "node pipeline/6_build/reference_layers.ts",
    "osm": "node notebooks/osm/osm_resources_nyc.ts",
    "typecheck": "tsc --noEmit",
    "lint": "eslint --no-error-on-unmatched-pattern notebooks/osm pipeline/6_build pipeline/5_load/__tests__",
    "lint:py": "uvx ruff check pipeline notebooks/analysis",
    "test": "node --test \"app/**/__tests__/*.test.mjs\" \"pipeline/**/__tests__/*.test.ts\"",
    "test:py": "uv run pipeline/1_clean/__tests__/clean_guide.test.py && uv run pipeline/2_pdf/__tests__/extend_with_pdf.test.py && python3 pipeline/__tests__/check_data.test.py",
    "check:data": "python3 pipeline/check_data.py",
    "check": "npm run -s typecheck && npm run -s lint && npm run -s lint:py && npm run -s test && npm run -s test:py && npm run -s check:data"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.6.6",
    "eslint": "^10.14.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.1"
  }
}
