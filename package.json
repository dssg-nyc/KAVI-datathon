{
  "name": "kavi-resource-map",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "dev": "node app/dev-server.mjs",
    "import": "node pipeline/load/import-resources.mjs",
    "osm": "node notebooks/osm/osm_resources_nyc.ts",
    "typecheck": "tsc --noEmit",
    "lint": "eslint --no-error-on-unmatched-pattern notebooks/osm pipeline/build",
    "test": "node --test \"app/**/__tests__/*.test.mjs\" \"pipeline/**/__tests__/*.test.ts\"",
    "test:py": "uv run pipeline/pdf/__tests__/extend_clean_resources.test.py",
    "check": "npm run -s typecheck && npm run -s lint && npm run -s test && npm run -s test:py"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.6.6",
    "eslint": "^10.14.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.1"
  }
}
