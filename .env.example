# Only needed to load data into Supabase (npm run import). The page itself needs no .env:
# its Supabase URL and publishable key are in the committed config.js.
#
# Copy to .env (git ignores it) and paste the secret key from
# Supabase dashboard -> Project Settings -> API Keys (KAVI organization), or ask a teammate in that org.
# The secret key bypasses RLS: never commit it or put it in config.js, index.html or any file the browser loads.
SUPABASE_SECRET_KEY=sb_secret_xxxxxxxxxxxxxx
